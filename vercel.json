{
  "buildCommand": "python3 build.py",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/v1.html",            "destination": "/archive/v1.html",            "permanent": true },
    { "source": "/v2.html",            "destination": "/archive/v2.html",            "permanent": true },
    { "source": "/v3.html",            "destination": "/archive/v3.html",            "permanent": true },
    { "source": "/v4.html",            "destination": "/archive/v4.html",            "permanent": true },
    { "source": "/v5.html",            "destination": "/archive/v5.html",            "permanent": true },
    { "source": "/v6.html",            "destination": "/archive/v6.html",            "permanent": true },
    { "source": "/v7.html",            "destination": "/archive/v7.html",            "permanent": true },
    { "source": "/v8.1.html",          "destination": "/archive/v8.1.html",          "permanent": true },
    { "source": "/v1-source.html",     "destination": "/archive/v1-source.html",     "permanent": true },
    { "source": "/v1-standalone.html", "destination": "/archive/v1-standalone.html", "permanent": true },
    { "source": "/v6-source.html",     "destination": "/archive/v6-source.html",     "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)zh-(TW|HK|MO|Hant)" }],
      "destination": "/v8.zh-hant.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)zh" }],
      "destination": "/v8.zh-hans.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)ru(-|;|,|\\s|$)" }],
      "destination": "/v8.ru.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)de(-|;|,|\\s|$)" }],
      "destination": "/v8.de.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)fr(-|;|,|\\s|$)" }],
      "destination": "/v8.fr.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)es(-|;|,|\\s|$)" }],
      "destination": "/v8.es.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)pt(-|;|,|\\s|$)" }],
      "destination": "/v8.pt.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)it(-|;|,|\\s|$)" }],
      "destination": "/v8.it.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)pl(-|;|,|\\s|$)" }],
      "destination": "/v8.pl.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)ja(-|;|,|\\s|$)" }],
      "destination": "/v8.ja.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)ko(-|;|,|\\s|$)" }],
      "destination": "/v8.ko.html"
    },
    { "source": "/", "destination": "/v8.html" },

    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)zh-(TW|HK|MO|Hant)" }],
      "destination": "/v8.zh-hant.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)zh" }],
      "destination": "/v8.zh-hans.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)ru(-|;|,|\\s|$)" }],
      "destination": "/v8.ru.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)de(-|;|,|\\s|$)" }],
      "destination": "/v8.de.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)fr(-|;|,|\\s|$)" }],
      "destination": "/v8.fr.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)es(-|;|,|\\s|$)" }],
      "destination": "/v8.es.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)pt(-|;|,|\\s|$)" }],
      "destination": "/v8.pt.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)it(-|;|,|\\s|$)" }],
      "destination": "/v8.it.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)pl(-|;|,|\\s|$)" }],
      "destination": "/v8.pl.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)ja(-|;|,|\\s|$)" }],
      "destination": "/v8.ja.html"
    },
    {
      "source": "/v8.html",
      "has": [{ "type": "header", "key": "accept-language", "value": "(^|,\\s*)ko(-|;|,|\\s|$)" }],
      "destination": "/v8.ko.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/v8(\\.[a-z-]+)?\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|favicon\\.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/archive/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
